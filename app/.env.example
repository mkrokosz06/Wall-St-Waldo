# Copy to `.env` and paste your real keys from the Alpaca dashboard (do not commit `.env`).
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# paper=true for sandbox, paper=false for live.
PAPER="true"

# If you want to override the trading base URL explicitly:
# ALPACA_TRADING_BASE_URL="https://paper-api.alpaca.markets/v2"

STATE_PATH="state.json"

# Logging
LOG_LEVEL="INFO"

# Strategy toggles (optional; defaults are in config.py)
# ENABLE_TIME_STOP="false"
# TIME_STOP_MINUTES="240"
# ENABLE_TREND_FILTER="true"
# ENABLE_SPY_MARKET_TREND_FILTER="false"
# ENABLE_CANDLESTICK_ENTRY_FILTER="true"
# ENABLE_CANDLESTICK_EXIT="true"
# REQUIRE_CANDLESTICK_CONFIRMATION="true"
# CANDLESTICK_VOLUME_CONFIRM_MULT="1.2"
# CANDLESTICK_SCORE_BONUS="0.00035"
# ENABLE_TRAILING_STOP="true"
# ENABLE_TREND_BREAK_EXIT="true"
# TREND_BREAK_MA_MINUTES="15"
# TREND_BREAK_CONFIRM_BARS="3"
# TREND_BREAK_SKIP_IF_PROFITABLE="true"
# TREND_BREAK_MIN_PROFIT_PCT_TO_SKIP="0"
# ENTRY_COOLDOWN_SEC="120"
# POST_LOSS_EXTRA_COOLDOWN_SEC="90"
# MIN_HOLD_MINUTES_BEFORE_STRUCTURE_EXIT="2"
# Per-symbol score nudges (merge with defaults; negative = pick less often)
# SYMBOL_SCORE_ADJUSTMENTS="SPY=-0.0004,IWM=-0.00025,QQQ=0.00006,VTI=0.00008"
# ENABLE_OFFLINE_TRAINING="true"
# OFFLINE_TRAINING_LOOKBACK_TRADES="15"
# ENABLE_ONLINE_TRAINING="true"
# ONLINE_TRAINING_WINDOW_TRADES="20"
# ONLINE_TRAINING_MIN_TRADES="3"
# ONLINE_TRAINING_NEUTRAL_BAND_ABS_USD="0.05"
