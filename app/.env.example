# Copy to `.env` and paste your real keys from the Alpaca dashboard (do not commit `.env`).
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# paper=true for sandbox, paper=false for live.
PAPER="true"

# If you want to override the trading base URL explicitly:
# ALPACA_TRADING_BASE_URL="https://paper-api.alpaca.markets/v2"

STATE_PATH="state.json"

# Logging
LOG_LEVEL="INFO"

# Strategy toggles (optional; defaults are in config.py)
# ENABLE_TIME_STOP="false"
# TIME_STOP_MINUTES="240"
# ENABLE_TREND_FILTER="true"
# ENABLE_SPY_MARKET_TREND_FILTER="false"
# ENABLE_CANDLESTICK_ENTRY_FILTER="true"
# ENABLE_CANDLESTICK_EXIT="true"
# REQUIRE_CANDLESTICK_CONFIRMATION="true"
# CANDLESTICK_VOLUME_CONFIRM_MULT="1.2"
# CANDLESTICK_SCORE_BONUS="0.00035"
# ENABLE_TRAILING_STOP="true"
# ENABLE_TREND_BREAK_EXIT="true"
# TREND_BREAK_MA_MINUTES="15"
# TREND_BREAK_CONFIRM_BARS="3"
# TREND_BREAK_SKIP_IF_PROFITABLE="true"
# TREND_BREAK_MIN_PROFIT_PCT_TO_SKIP="0"
# ENTRY_COOLDOWN_SEC="120"

# Cap on distinct entry intents per ET session date. Default 3.
#
# IMPORTANT: this cap became real on 2026-09-15. Before that config.py defined
# it and bot.py incremented the counter, but nothing ever compared the two, so
# every historical run - and every backtest in app/research/ - had UNLIMITED
# entries. Enforcing the documented default of 3 is therefore a change in
# behaviour, and on this strategy it is a large one: the backtests place roughly
# 2-8 entries per session, so a cap of 3 will materially reduce trading.
#
# Set to 0 to keep the previous unlimited behaviour.
# MAX_ENTRY_ATTEMPTS_PER_DAY="3"
# POST_LOSS_EXTRA_COOLDOWN_SEC="90"
# MIN_HOLD_MINUTES_BEFORE_STRUCTURE_EXIT="2"
# Per-symbol score nudges (merge with defaults; negative = pick less often)
# SYMBOL_SCORE_ADJUSTMENTS="SPY=-0.0004,IWM=-0.00025,QQQ=0.00006,VTI=0.00008"
# ENABLE_OFFLINE_TRAINING="true"
# OFFLINE_TRAINING_LOOKBACK_TRADES="15"
# ENABLE_ONLINE_TRAINING="true"
# ONLINE_TRAINING_WINDOW_TRADES="20"
# ONLINE_TRAINING_MIN_TRADES="3"
# ONLINE_TRAINING_NEUTRAL_BAND_ABS_USD="0.05"

# Universe: comma-separated tickers. Default is leveraged ETFs.
# SYMBOLS_UNIVERSE="TQQQ,SOXL,SQQQ,UVXY,SOXS"

# Notional market entry. Set true to trade SPY/QQQ-class tickers where 1 whole
# share does not fit in account cash. When true, Alpaca stop orders on fractional
# positions are not allowed; the bot falls back to a synthetic stop.
# USE_NOTIONAL_MARKET_ENTRY="false"
# NOTIONAL_ENTRY_MIN_USD="1.0"

# --- Risk levels (these are now actually read; they were ignored before) ---
STOP_LOSS_PCT=0.006
TAKE_PROFIT_PCT=0.012
TRAILING_STOP_PCT=0.004

# --- Shutdown safety ---
# The end-of-day flatten only runs while the loop is alive. Without these the
# bot leaves open positions behind when stopped or crashed, which is
# uncompensated overnight gap risk on 3x leveraged ETFs.
FLATTEN_ON_SHUTDOWN="true"
FLATTEN_STALE_POSITIONS_ON_START="true"
# Flatten long positions in symbols that are no longer in SYMBOLS_UNIVERSE.
# Such positions are invisible to every exit rule, so nothing else will ever
# close them. Set "false" only if this account also holds manual positions.
FLATTEN_UNTRACKED_POSITIONS_ON_START="true"
